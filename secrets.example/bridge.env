# Discord bot token and the one channel where @mentions start a thread.
DISCORD_BOT_TOKEN=replace-me
DISCORD_CHANNEL_ID=replace-me
# How many threads the agent works on at the same time (one OpenCode session each).
MAX_CONCURRENT=16
# Requests running longer than this many seconds are stopped (default 1800 = 30 min).
PROMPT_TIMEOUT_SECONDS=1800
