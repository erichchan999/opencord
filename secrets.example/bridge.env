# Discord bot token.
DISCORD_BOT_TOKEN=replace-me
# Comma-separated text channel IDs OpenCord accepts input from.
DISCORD_CHANNEL_IDS=
# How many threads the agent works on at the same time (one OpenCode session each).
MAX_CONCURRENT=16
# A request is stopped once it has worked this many seconds (default 1800 = 30 min).
# Time spent waiting for someone to answer the agent's question is not counted.
PROMPT_TIMEOUT_SECONDS=1800
# A request is stopped when the agent shows no activity for this many seconds (default 900 = 15 min).
PROMPT_SILENCE_SECONDS=900
# A request is stopped when a question from the agent goes unanswered this many seconds (default 3600 = 60 min).
QUESTION_TIMEOUT_SECONDS=3600
# A /shell command is stopped after this many seconds (default 600 = 10 min).
SHELL_TIMEOUT_SECONDS=600
