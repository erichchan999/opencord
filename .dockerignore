!compose.yaml
!start.sh
!start.ps1
!.gitattributes
!.gitignore
!discord-bridge
!llm-proxy
!opencode-agent
!secrets.example
**/__pycache__
**/.pytest_cache
# Never, whatever is listed above.
secrets
