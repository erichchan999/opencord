{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-proxy/deepseek-flash",
  "small_model": "deepseek-proxy/deepseek-flash",
  "enabled_providers": ["deepseek-proxy"],
  "provider": {
    "deepseek-proxy": {
      "name": "DeepSeek (via llm-proxy)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm-proxy:8080/v1",
        "apiKey": "sandbox-placeholder-the-proxy-adds-the-real-key"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "tool_call": true,
          "limit": { "context": 128000, "output": 8192 },
          "variants": {
            "off": { "thinking": { "type": "disabled" } },
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "tool_call": true,
          "limit": { "context": 128000, "output": 8192 },
          "variants": {
            "off": { "thinking": { "type": "disabled" } },
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        }
      }
    }
  },
  "permission": "allow",
  "share": "disabled",
  "autoupdate": false
}
